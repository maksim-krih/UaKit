{
  "name": "uakit",
  "version": "0.1.0",
  "description": "Сума прописом, число прописом, перевірка ЄДРПОУ та ІПН (РНОКПП) з датою народження і статтю. Ukrainian amount in words (UAH, USD, EUR), number to words, EDRPOU and RNOKPP validation. Zero dependencies.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run build && npm test",
    "prepack": "node -e \"for(const f of ['README.md','LICENSE'])require('fs').copyFileSync('../'+f,f)\""
  },
  "keywords": [
    "сума прописом",
    "прописом",
    "число прописом",
    "гривня",
    "гривні прописом",
    "ЄДРПОУ",
    "ІПН",
    "РНОКПП",
    "ukraine",
    "ukrainian",
    "amount-in-words",
    "number-to-words",
    "num2words",
    "spell-number",
    "money-to-words",
    "hryvnia",
    "uah",
    "edrpou",
    "rnokpp",
    "inn",
    "ipn",
    "tax-id",
    "validation",
    "invoice"
  ],
  "author": "Maksim Krykh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maksim-krih/UaKit.git",
    "directory": "js"
  },
  "homepage": "https://maksim-krih.github.io/UaKit/",
  "bugs": {
    "url": "https://github.com/maksim-krih/UaKit/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
